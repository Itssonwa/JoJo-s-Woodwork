body {
  background-color: #d3aefb;
  font-family: Arial, sans-serif;
  text-align: center;
  margin: 0;
  padding: 0;
}

.container {
  max-width: 800px;
  margin: 0 auto;
  padding: 20px;
}

.logo {
  background-color: #8ecae6;
  padding: 20px;
  border-radius: 10px;
}

.examples {
  background-color: #fbc4ab;
  margin: 20px 0;
  padding: 20px;
  border-radius: 10px;
}

.examples img {
  max-width: 100%; 
  height: auto;      
  display: block;    
  margin: 15px auto; 
  border-radius: 8px;}

.buttons {
  display: flex;
  justify-content: space-around;
  margin-top: 20px;
}

.btn {
  padding: 10px 20px;
  border-radius: 10px;
  text-decoration: none;
  color: #000;
  font-weight: bold;
}

.order {
  background-color: #90ee90;
}

.about {
  background-color: #ffcc80;
}

.contact {
  background-color: #90ee90;
}


/* Order page styling */
.top-nav {
  text-align: right;
  margin: 20px;
}

.home {
  background-color: #8ecae6;
  padding: 10px 20px;
  border-radius: 10px;
  text-decoration: none;
  color: #000;
  font-weight: bold;
}

.order-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30px;
  justify-items: center;
  margin-top: 50px;
}

.order-item {
  background-color: #c1f0c1;
  border: 2px solid #4caf50;
  border-radius: 15px;
  padding: 40px;
  width: 150px;
  text-align: center;
  font-weight: bold;
  text-decoration: none;
  color: #000;
  transition: 0.3s;
}

.order-item:hover {
  background-color: #a5d6a7;
  transform: scale(1.05);
}


